### ER model with 2 hidden states ###
setwd("")
CHARACTER = ""

morpho <- readDiscreteCharacterData(""+CHARACTER+".nex")
moves = VectorMoves()
monitors = VectorMonitors()
phylogeny <- readTrees("")[1]

NUM_EVENTS = 200
rate_pr := phylogeny.treeLength() / NUM_EVENTS

NUM_STATES = 3
NUM_RATES = NUM_STATES * (NUM_STATES-1)
for ( i in 1:NUM_RATES ) {
    rate[i] ~ dnExp(rate_pr)
    moves.append( mvScale( rate[i], weight=2 ) )
}

Q_morpho := fnFreeK( rate, rescale=false )

rf_prior <- rep(1,NUM_STATES)
rf ~ dnDirichlet( rf_prior )
moves.append( mvBetaSimplex( rf, weight=2 ) )
moves.append( mvDirichletSimplex( rf, weight=2 ) )

phyMorpho ~ dnPhyloCTMC(tree=phylogeny, Q=Q_morpho, rootFrequencies=rf, type="Standard")
phyMorpho.clamp(morpho)

mymodel = model(phylogeny)
monitors.append( mnModel(filename=""+CHARACTER+"_ARD_output/ARD.log", printgen=1) )
monitors.append( mnScreen(printgen=100) )
monitors.append( mnJointConditionalAncestralState(tree=phylogeny,
                                                 ctmc=phyMorpho,
                                                 filename=""+CHARACTER+"_ARD_output/ARD.states.txt",
                                                 type="Standard",
                                                 printgen=1,
                                                 withTips=true,
                                                 withStartStates=false) )

monitors.append( mnStochasticCharacterMap(ctmc=phyMorpho,
                                          filename=""+CHARACTER+"_ARD_output/ARD_stoch_char_map.log",
                                          printgen=1,
                                          include_simmap=true) )

# Initialize the MCMC object #
mymcmc = mcmc(mymodel, monitors, moves, nruns=2, combine="mixed")

# Run the MCMC #
mymcmc.run(generations=50000, tuningInterval=200)

anc_states = readAncestralStateTrace(""+CHARACTER+"_ARD_output/ARD.states.txt")
anc_tree = ancestralStateTree(tree=phylogeny, 
ancestral_state_trace_vector=anc_states, 
include_start_states=false, 
file=""+CHARACTER+"_ARD_output/ARD.tree", 
burnin=0.25, 
summary_statistic="MAP", 
site=1,
nStates=NUM_STATES)

anc_states_stoch_map = readAncestralStateTrace(""+CHARACTER+"_ARD_output/ARD_stoch_char_map.log")
#summarizeCharacterMaps(anc_states_stoch_map, phylogeny, file=""+CHARACTER+"_ARD_output/ARD_stoch_summary.tsv", burnin=0.25)

char_map_tree = characterMapTree(phylogeny,
                 ancestral_state_trace_vector=anc_states_stoch_map,
                 character_file=""+CHARACTER+"_ARD_output/ARD_stoch_map_character.tree",
                 posterior_file=""+CHARACTER+"_ARD_output/ARD_stoch_map_posterior.tree",
                 shift_prob_file=""+CHARACTER+"_ARD_output/ARD_stoch_map_marginal_shift.tree",
                 burnin=0.25,
                 reconstruction="marginal")

q()
