moves.append( mvScale( rate_21_sd, weight=2 ) )
rate_21 := fnDiscretizeDistribution( dnLognormal( ln(rate_21_median), rate_21_sd ), NUM_HIDDEN_STATES )

rate_34_median ~ dnExponential( rate_pr )
rate_34_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_34_median, weight=2 ) )
moves.append( mvScale( rate_34_sd, weight=2 ) )
rate_34 := fnDiscretizeDistribution( dnLognormal( ln(rate_34_median), rate_34_sd ), NUM_HIDDEN_STATES )
rate_43_median ~ dnExponential( rate_pr )
rate_43_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_43_median, weight=2 ) )
moves.append( mvScale( rate_43_sd, weight=2 ) )
rate_43 := fnDiscretizeDistribution( dnLognormal( ln(rate_43_median), rate_43_sd ), NUM_HIDDEN_STATES )

rate_53_median ~ dnExponential( rate_pr )
rate_53_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_53_median, weight=2 ) )
moves.append( mvScale( rate_53_sd, weight=2 ) )
rate_53 := fnDiscretizeDistribution( dnLognormal( ln(rate_53_median), rate_53_sd ), NUM_HIDDEN_STATES )
rate_35_median ~ dnExponential( rate_pr )
rate_35_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_35_median, weight=2 ) )
moves.append( mvScale( rate_35_sd, weight=2 ) )
rate_35 := fnDiscretizeDistribution( dnLognormal( ln(rate_35_median), rate_35_sd ), NUM_HIDDEN_STATES )

rate_45_median ~ dnExponential( rate_pr )
rate_45_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_45_median, weight=2 ) )
moves.append( mvScale( rate_45_sd, weight=2 ) )
rate_45 := fnDiscretizeDistribution( dnLognormal( ln(rate_45_median), rate_45_sd ), NUM_HIDDEN_STATES )
rate_54_median ~ dnExponential( rate_pr )
rate_54_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_54_median, weight=2 ) )
moves.append( mvScale( rate_54_sd, weight=2 ) )
rate_54 := fnDiscretizeDistribution( dnLognormal( ln(rate_54_median), rate_54_sd ), NUM_HIDDEN_STATES )

rate_67_median ~ dnExponential( rate_pr )
rate_67_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_67_median, weight=2 ) )
moves.append( mvScale( rate_67_sd, weight=2 ) )
rate_67 := fnDiscretizeDistribution( dnLognormal( ln(rate_67_median), rate_67_sd ), NUM_HIDDEN_STATES )
rate_76_median ~ dnExponential( rate_pr )
rate_76_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_76_median, weight=2 ) )
moves.append( mvScale( rate_76_sd, weight=2 ) )
rate_76 := fnDiscretizeDistribution( dnLognormal( ln(rate_76_median), rate_76_sd ), NUM_HIDDEN_STATES )

rate_86_median ~ dnExponential( rate_pr )
rate_86_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_86_median, weight=2 ) )
moves.append( mvScale( rate_86_sd, weight=2 ) )
rate_86 := fnDiscretizeDistribution( dnLognormal( ln(rate_86_median), rate_86_sd ), NUM_HIDDEN_STATES )
rate_68_median ~ dnExponential( rate_pr )
rate_68_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_68_median, weight=2 ) )
moves.append( mvScale( rate_68_sd, weight=2 ) )
rate_68 := fnDiscretizeDistribution( dnLognormal( ln(rate_68_median), rate_68_sd ), NUM_HIDDEN_STATES )

rate_78_median ~ dnExponential( rate_pr )
rate_78_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_78_median, weight=2 ) )
moves.append( mvScale( rate_78_sd, weight=2 ) )
rate_78 := fnDiscretizeDistribution( dnLognormal( ln(rate_78_median), rate_78_sd ), NUM_HIDDEN_STATES )
rate_87_median ~ dnExponential( rate_pr )
rate_87_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_87_median, weight=2 ) )
moves.append( mvScale( rate_87_sd, weight=2 ) )
rate_87 := fnDiscretizeDistribution( dnLognormal( ln(rate_87_median), rate_87_sd ), NUM_HIDDEN_STATES )

rate_910_median ~ dnExponential( rate_pr )
rate_910_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_910_median, weight=2 ) )
moves.append( mvScale( rate_910_sd, weight=2 ) )
rate_910 := fnDiscretizeDistribution( dnLognormal( ln(rate_910_median), rate_910_sd ), NUM_HIDDEN_STATES )
rate_109_median ~ dnExponential( rate_pr )
rate_109_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_109_median, weight=2 ) )
moves.append( mvScale( rate_109_sd, weight=2 ) )
rate_109 := fnDiscretizeDistribution( dnLognormal( ln(rate_109_median), rate_109_sd ), NUM_HIDDEN_STATES )

rate_119_median ~ dnExponential( rate_pr )
rate_119_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_119_median, weight=2 ) )
moves.append( mvScale( rate_119_sd, weight=2 ) )
rate_119 := fnDiscretizeDistribution( dnLognormal( ln(rate_119_median), rate_119_sd ), NUM_HIDDEN_STATES )
rate_911_median ~ dnExponential( rate_pr )
rate_911_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_911_median, weight=2 ) )
moves.append( mvScale( rate_911_sd, weight=2 ) )
rate_911 := fnDiscretizeDistribution( dnLognormal( ln(rate_911_median), rate_911_sd ), NUM_HIDDEN_STATES )

rate_1011_median ~ dnExponential( rate_pr )
rate_1011_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_1011_median, weight=2 ) )
moves.append( mvScale( rate_1011_sd, weight=2 ) )
rate_1011 := fnDiscretizeDistribution( dnLognormal( ln(rate_1011_median), rate_1011_sd ), NUM_HIDDEN_STATES )
rate_1110_median ~ dnExponential( rate_pr )
rate_1110_sd ~ dnExponential( SD_PRIOR )
moves.append( mvScale( rate_1110_median, weight=2 ) )
moves.append( mvScale( rate_1110_sd, weight=2 ) )
rate_1110 := fnDiscretizeDistribution( dnLognormal( ln(rate_1110_median), rate_1110_sd ), NUM_HIDDEN_STATES )

switch_VS_S ~ dnExponential( rate_pr )
switch_VS_F ~ dnExponential( rate_pr )
switch_VS_VF ~ dnExponential( rate_pr )
switch_S_VS ~ dnExponential( rate_pr )
switch_S_F ~ dnExponential( rate_pr )
switch_S_VF ~ dnExponential( rate_pr )
switch_F_VS ~ dnExponential( rate_pr )
switch_F_S ~ dnExponential( rate_pr )
switch_F_VF ~ dnExponential( rate_pr )
switch_VF_VS ~ dnExponential( rate_pr )
switch_VF_S ~ dnExponential( rate_pr )
switch_VF_F ~ dnExponential( rate_pr )

moves.append( mvScale( switch_VS_S, weight=2 ) )
moves.append( mvScale( switch_VS_F, weight=2 ) )
moves.append( mvScale( switch_VS_VF, weight=2 ) )
moves.append( mvScale( switch_S_VS, weight=2 ) )
moves.append( mvScale( switch_S_F, weight=2 ) )
moves.append( mvScale( switch_S_VF, weight=2 ) )
moves.append( mvScale( switch_F_VS, weight=2 ) )
moves.append( mvScale( switch_F_S, weight=2 ) )
moves.append( mvScale( switch_F_VF, weight=2 ) )
moves.append( mvScale( switch_VF_VS, weight=2 ) )
moves.append( mvScale( switch_VF_S, weight=2 ) )
moves.append( mvScale( switch_VF_F, weight=2 ) )

rates[1][2] := rate_01[1]
rates[2][1] := rate_10[1]
rates[1][3] := rate_02[1]
rates[3][1] := rate_20[1]
rates[2][3] := rate_12[1]
rates[3][2] := rate_21[1]


rates[4][5] := rate_34[2]
rates[5][4] := rate_43[2]
rates[4][6] := rate_35[2]
rates[6][4] := rate_53[2]
rates[5][6] := rate_45[2]
rates[6][5] := rate_54[2]

rates[7][8] := rate_67[3]
rates[8][7] := rate_76[3]
rates[7][9] := rate_68[3]
rates[9][7] := rate_86[3]
rates[8][9] := rate_78[3]
rates[9][8] := rate_87[3]

rates[10][11] := rate_910[4]
rates[11][10] := rate_109[4]
rates[10][12] := rate_911[4]
rates[12][10] := rate_119[4]
rates[11][12] := rate_1011[4]
rates[12][11] := rate_1110[4]


Q_morpho := fnFreeK(rates, rescaled=FALSE)

### Draw root state frequencies from Dirichlet prior distribution ###
rf_prior <- rep(1,NUM_STATES * NUM_HIDDEN_STATES)
rf ~ dnDirichlet( rf_prior )
moves.append( mvBetaSimplex( rf, weight=2 ) )
moves.append( mvDirichletSimplex( rf, weight=2 ) )

phyMorpho ~ dnPhyloCTMC(tree=phylogeny, Q=Q_morpho, rootFrequencies=rf, type="NaturalNumbers")
phyMorpho.clamp(morpho_exp)
mymodel = model(phylogeny)

monitors.append( mnModel(filename=""+CHARACTER+"_HRM4_ARD_output/HRM4_ARD.log", printgen=1) )
monitors.append( mnScreen(printgen=10) )
monitors.append( mnJointConditionalAncestralState(tree=phylogeny,
                                                 ctmc=phyMorpho,
                                                 filename=""+CHARACTER+"_HRM4_ARD_output/HRM4_ARD.states.txt",
                                                 type="NaturalNumbers",
                                                 printgen=1,
                                                 withTips=true,
                                                 withStartStates=false) )
monitors.append( mnStochasticCharacterMap(ctmc=phyMorpho,
                                          filename=""+CHARACTER+"_HRM4_ARD_output/HRM4_ARD_stoch_char_map.log",
                                          printgen=1,
                                          include_simmap=true) )

### Estimate marginal likelihoods ###
pow_p = powerPosterior(mymodel, moves, monitors, ""+CHARACTER+"_HRM4_ARD_output/HRM4_ARD.out", cats=50) 
pow_p.burnin(generations=10000,tuningInterval=1000)
pow_p.run(generations=1000)  

### Stepping stone sampler ###
ss = steppingStoneSampler(file=""+CHARACTER+"_HRM4_ARD_output/HRM4_ARD.out", powerColumnName="power", likelihoodColumnName="likelihood")
ss.marginal()
marginal_likelihood = ss.marginal()
# 输出到txt文件
output_file = ""+CHARACTER+"_HRM4_ARD_ss_marginal.txt"
write(file=output_file, CHARACTER+"_HRM4_ARD,"+marginal_likelihood)

q()
