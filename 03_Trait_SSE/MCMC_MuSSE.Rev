setwd("")
CHARACTER = ""

NUM_TOTAL_SPECIES     = ##
NUM_SPECIES           = ##
NUM_STATES            = 3
NUM_RATES             = NUM_STATES
H                     = 0.587405

observed_phylogeny <- readTrees("")[1]
data <- readCharacterData(""+CHARACTER+".nex")
taxa <- observed_phylogeny.taxa()
root_age <- observed_phylogeny.rootAge()

mvi = 0
mni = 0

rate_mean <- ln( ln(NUM_SPECIES/2.0) / root_age )
rate_sd ~ dnExponential( 1.0 / H )
moves[++mvi] = mvScale( rate_sd, lambda=1.0, tune=true, weight=2.0 )

for (i in 1:NUM_STATES) {

    log_speciation[i] ~ dnNormal(mean=rate_mean, sd=rate_sd)
    speciation[i] := exp(log_speciation[i])
    moves[++mvi] = mvSlide(log_speciation[i],delta=0.5,tune=true,weight=3.0)

    log_extinction[i] ~ dnNormal(mean=rate_mean, sd=rate_sd)
    extinction[i] := exp(log_extinction[i])
    moves[++mvi] = mvSlide(log_extinction[i],delta=0.5,tune=true,weight=3.0)

}

rate_pr := observed_phylogeny.treeLength() / 200
for ( i in 1:(NUM_STATES*(NUM_STATES-1)) ) {
    transition_rates[i] ~ dnExp(rate_pr)
    moves[++mvi] = mvScale(transition_rates[i],lambda=1.0,tune=true,weight=2.0)
}

rate_matrix := fnFreeK(transition_rates, rescaled=false)

root_prior ~ dnDirichlet( rep(1,NUM_RATES) )
moves[++mvi] = mvDirichletSimplex(root_prior,tune=true,weight=2)
moves[++mvi] = mvBetaSimplex(root_prior,tune=true,weight=2)

rho <- observed_phylogeny.ntips()/NUM_TOTAL_SPECIES

timetree ~ dnCDBDP( rootAge = root_age,
speciationRates   = speciation,
extinctionRates   = extinction,
nTimeSlices       = 500,
Q                 = rate_matrix,
pi                = root_prior,
delta             = 1,
rho               = rho)

timetree.clamp( observed_phylogeny )
timetree.clampCharData( data )
mymodel = model(rate_matrix)

monitors[++mni] = mnModel(filename=""+CHARACTER+"/MuSSE.log", printgen=10)
monitors[++mni] = mnJointConditionalAncestralState(tree=timetree, cdbdp=timetree, type="Standard", printgen=10, withTips=true, withStartStates=false, filename=""+CHARACTER+"/MuSSE_anc_states.log")
monitors[++mni] = mnStochasticCharacterMap(cdbdp=timetree, printgen=10, filename=""+CHARACTER+"/MuSSE_stoch_map.log", include_simmap=true)
monitors[++mni] = mnScreen(printgen=10, speciation, extinction)

mymcmc = mcmc(mymodel, monitors, moves, nruns=5, moveschedule="random", combine="mixed")
mymcmc.run(generations=40000, tuningInterval=1000)

anc_states = readAncestralStateTrace(""+CHARACTER+"/MuSSE_anc_states.log")
anc_tree = ancestralStateTree(tree=observed_phylogeny, ancestral_state_trace_vector=anc_states, include_start_states=false, file=""+CHARACTER+"/MuSSE_anc_states.tree", burnin=0.25, summary_statistic="MAP", site=1, nStates=3)


q()
